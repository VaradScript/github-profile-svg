{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/trophies",
            "destination": "/api/trophies.js"
        },
        {
            "source": "/api/profile",
            "destination": "/api/trophies.js"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "image/svg+xml"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=60"
                }
            ]
        }
    ]
}